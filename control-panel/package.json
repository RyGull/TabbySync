{
  "name": "tabbysync-control-panel",
  "productName": "TabbySync Control Panel",
  "version": "1.6.0",
  "description": "Windows desktop app for managing every TabbySync sync profile, bookmark and saved tab list in one place.",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "author": "Ryan Gulliver",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:native": "node-gyp rebuild --directory=native/hello",
    "icon": "node scripts/make-icon.mjs",
    "prestart": "npm run vendor && npm run icon && npm run build:native",
    "start": "electron .",
    "pretest": "npm run vendor",
    "test": "node --test test/*.test.js",
    "predist:win": "npm run vendor && npm run icon && npm run build:native",
    "dist:win": "electron-builder --win --publish never",
    "predist:win:dir": "npm run vendor && npm run icon && npm run build:native",
    "dist:win:dir": "electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "node-addon-api": "^8.0.0",
    "node-gyp": "^13.0.2",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.tabbysync.controlpanel",
    "productName": "TabbySync Control Panel",
    "copyright": "Copyright (c) 2026 Ryan Gulliver",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "vendor/**/*",
      "native/hello/build/Release/*.node",
      "build/icon.ico",
      "!**/*.test.js"
    ],
    "asarUnpack": [
      "native/hello/build/Release/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TabbySync Control Panel",
      "artifactName": "TabbySync-Control-Panel-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TabbySync-Control-Panel-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RyGull",
        "repo": "TabbySync"
      }
    ]
  }
}
