# TabbySync marketing site — Apache configuration.
#
# config.php and the templates have always assumed this file exists: they link
# to /contact and /privacy rather than /contact.php and /privacy.php, and the
# contact form's comments refer to the .php -> clean-URL redirect below.
#
# ---------------------------------------------------------------------------
# BEFORE DEPLOYING, check these two things:
#
#   1. HTTPS. The redirect in "Canonical scheme and host" sends every plain
#      http:// request to https://, and Strict-Transport-Security (sent by
#      config.php's send_security_headers) tells browsers to stop trying
#      http:// for a year. On a host without a working certificate that is a
#      self-inflicted outage — comment the rule out until the certificate is
#      in place.
#
#   2. The host name. The www -> apex redirect assumes tabbysync.com, matching
#      SITE_URL in config.php. If the site lives anywhere else, change both.
#
# Security headers for PHP pages are NOT set here. config.php sends them, so
# they apply on any host, Apache or not; this file covers only the static
# files PHP never sees. Setting the same header in both places is how a site
# ends up serving two different Content-Security-Policy values and enforcing
# the intersection of them.
# ---------------------------------------------------------------------------

Options -Indexes +FollowSymLinks
ServerSignature Off
DirectoryIndex index.php index.html

AddDefaultCharset UTF-8

ErrorDocument 404 /404.php

# ---------------------------------------------------------------------------
# Files that are never a page
# ---------------------------------------------------------------------------

# privacy.html is a data file: /privacy reads it and renders it inside the
# site's chrome. Served directly it would be an unstyled duplicate of the
# policy competing with the real page in search results.
<Files "privacy.html">
  Require all denied
</Files>

# Documentation and the includes directory have no business being fetchable.
<FilesMatch "^(README\.md|.*\.(md|log|bak|inc|sql|json))$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^includes/ - [F,L]

  # -------------------------------------------------------------------------
  # Canonical scheme and host
  # -------------------------------------------------------------------------
  # One URL per page, or search engines split a page's standing across four
  # spellings of it (http/https x www/apex). See the deployment note above
  # before enabling on a host without HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # -------------------------------------------------------------------------
  # Clean URLs
  # -------------------------------------------------------------------------
  # /sitemap.xml is generated by sitemap.php so its <lastmod> dates cannot go
  # stale; robots.txt advertises the .xml name, which is what crawlers expect.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # /contact.php -> /contact, and the same for every other page, so only the
  # extensionless form is ever linked to or indexed. The form itself posts
  # back to whatever URL served it, which is why this redirect cannot swallow
  # a submission: a POST is excluded outright.
  RewriteCond %{REQUEST_METHOD} !=POST
  RewriteCond %{THE_REQUEST} "\s/+(.+?)\.php[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L]

  # index.php -> /
  RewriteCond %{REQUEST_METHOD} !=POST
  RewriteCond %{THE_REQUEST} "\s/+index\.php[\s?]" [NC]
  RewriteRule ^ / [R=301,L]

  # Serve /contact from contact.php, /privacy from privacy.php, and so on.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^.]+)$ $1.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Static files: the headers PHP cannot send for them, and caching
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>
  # Same guarantees send_security_headers() gives the pages, for the assets
  # served straight off disk. No CSP here: a stylesheet or a PNG is not a
  # browsing context, and the pages that embed them are already covered.
  <FilesMatch "\.(css|js|png|svg|ico|txt|xml|webmanifest|woff2?)$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
  </FilesMatch>

  # Never cached: the pages themselves, so a deploy is live immediately.
  <FilesMatch "\.php$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Assets are versioned by content, not by name, so a month is the honest
  # ceiling here — long enough to matter for repeat visits and Core Web
  # Vitals, short enough that a CSS change isn't invisible for a year.
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png             "access plus 1 month"
  ExpiresByType image/svg+xml         "access plus 1 month"
  ExpiresByType image/x-icon          "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>
