{
  "name": "tabbysync",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Dev tooling for the TabbySync extension: the test harness and the screenshot generator. The extension itself reads none of this and ships with no dependencies.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "screenshots": "node scripts/screenshots.mjs",
    "e2e:switch": "node scripts/e2e-switch-destination.mjs",
    "e2e:bulk": "node scripts/e2e-bulk-open.mjs",
    "package": "bash scripts/package.sh",
    "package:firefox": "bash scripts/package.sh firefox",
    "dev:firefox": "bash scripts/package.sh firefox --dir",
    "lint:firefox": "bash scripts/package.sh firefox && npx --yes addons-linter dist/tabbysync-$npm_package_version-firefox.zip",
    "package:source": "bash scripts/package.sh source"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
