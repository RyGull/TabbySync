
# Never commit reCAPTCHA keys. config.local.php holds the marketing site's
# site key and secret key; config.local.example.php is the committed template
# to copy from. A key that reaches a public commit is public permanently —
# removing it in a later commit leaves it in the history and in every fork.
website/config.local.php
server/feedback/config.php

# Build output
dist/

# Local dev tooling (playwright, for scripts/screenshots.mjs)
node_modules/

# 2x source captures — regenerate with scripts/screenshots.mjs; the web/ and
# store/ sets derived from them are committed.
docs/screenshots/raw/
